NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Cliente: legacy anon JWT o Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_publishable_o_anon_key
# Solo servidor: legacy service_role JWT o Secret key (sb_secret_...) — API → Secret keys → default
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Alias opcional (mismo valor que arriba):
# SUPABASE_SECRET_KEY=sb_secret_...
